CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_PROFILE="DEVICE_qihoo_360t7"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"

CONFIG_LINUX_6_6=y

# 优化CPU
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"

# Rootfs
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=160

# ❌ 去掉 initramfs
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE is not set

# 基础系统
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y

# 网络
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# NAT性能
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-ipt-fullconenat=y
CONFIG_PACKAGE_kmod-ipt-nat=y

# ❌ 精简iptables
# CONFIG_PACKAGE_kmod-ipt-nat6 is not set
# CONFIG_PACKAGE_kmod-ipt-physdev is not set

# PPP
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# IPv6（正常双栈）
CONFIG_PACKAGE_odhcpd=y
# CONFIG_PACKAGE_odhcpd-ipv6only is not set

# WiFi（闭源）
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y

# 保留硬件加速（你要求）
CONFIG_PACKAGE_kmod-mtk-warp=y
CONFIG_PACKAGE_kmod-mtkhnat=y

# 加密
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_ca-bundle=y

# LuCI
CONFIG_PACKAGE_luci-light=y

# SSH
CONFIG_PACKAGE_dropbear=y

# WireGuard（备用）
CONFIG_PACKAGE_kmod-wireguard=y

# 日志
CONFIG_PACKAGE_logd=y

# ❌ 删除没用组件
# CONFIG_PACKAGE_ksmbd is not set
# CONFIG_PACKAGE_wrtbwmon is not set
# CONFIG_PACKAGE_kmod-fs-btrfs is not set

# ❌ 删除内核调试（性能关键）
# CONFIG_KERNEL_DEBUG_KERNEL is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_PRINTK_TIME is not set

# 工具链
CONFIG_GCC_USE_VERSION_13=y
CONFIG_BINUTILS_USE_VERSION_2_42=y
CONFIG_LIBC_USE_MUSL=y

# 编译
CONFIG_MAKE_TOOLCHAIN=y
CONFIG_TOOLCHAINOPTS=y
